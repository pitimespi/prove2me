import Definitions.Def_BitcoinScriptV2
import Definitions.Def_BitcoinTaproot
open BitcoinSer BitcoinSig BitcoinVerify BitcoinTaproot
/-- `VerifyScript` with the V2 (L1/L10-closed) evaluator on the legacy and witness-v0 paths. -/
def verifyScriptFullV2 (spent : List TxOut) (c : BitcoinVerify.Ctx) (scriptSig scriptPubKey : Bytes) (witness : List Bytes) : Bool :=
  BitcoinScriptV2.verifyScriptV2 (taprootHandler spent) c scriptSig scriptPubKey witness


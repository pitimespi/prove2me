import Definitions.Def_BitcoinBlockV2
open BitcoinBlockV2 BitcoinSer
/-! Spot 12 vectors (`REVIEW_SPOT12.md`): `CheckMerkleRoot` with CVE-2012-2459 mutation detection on
mainnet block 586 (three transactions), `GetWitnessCommitmentIndex` and `CheckWitnessMalleation` on synthetic
blocks. Expectations computed by `tests/reference/checkblock_reference.py`. Every line prints `true`. -/
def hexVal (c : Char) : Nat := if c.isDigit then c.toNat - 48 else c.toLower.toNat - 87
def ofHexL : List Char → Bytes
  | a :: b :: r => BitVec.ofNat 8 (hexVal a * 16 + hexVal b) :: ofHexL r
  | _ => []
def ofHex (s : String) : Bytes := ofHexL s.toList
-- mainnet block 586, hash 000000000d0d23516c5efd3af4eb951603bb30b2c93884b522a318b30e918ee7
def block586 : Block := ((readBlock true (ofHex "")).map Prod.fst).getD genesisBlock
#eval block586.vtx.length == 3
#eval headerHash block586.header == (ofHex "000000000d0d23516c5efd3af4eb951603bb30b2c93884b522a318b30e918ee7").reverse
#eval checkHeaderPow block586.header
#eval blockMerkleRoot block586 == (ofHex "4d5969c0d10dcce60868fee4d4de80ba5ef38abaeed8a75daa63e48c963d7b19", false)
#eval checkBlock block586
def mutated586 : Block := ⟨block586.header, block586.vtx ++ [block586.vtx.getLastD genesisCoinbase]⟩   -- [a,b,c,c]: same root, mutated
#eval (blockMerkleRoot mutated586).1 == block586.header.merkleRoot
#eval (blockMerkleRoot mutated586).2 == true
#eval checkBlock mutated586 == false                                   -- bad-txns-duplicate
#eval (serBlock false mutated586).length == 1271            -- 80 + 1 + stripped sizes; well within the limit
#eval (mutated586.vtx.drop 1).all (fun tx => !isCoinBase tx) && mutated586.vtx.all checkTransaction   -- nothing else rejects it
def dup586 : Block := ⟨block586.header, block586.vtx ++ [block586.vtx.getD 1 genesisCoinbase, block586.vtx.getD 2 genesisCoinbase]⟩   -- [a,b,c,b,c]: different root, no equal pair
#eval blockMerkleRoot dup586 == (ofHex "fab883c2ddae2e11391d97c46d76d58af5ac91fbffd6811a640767bb817076d1", false)
#eval checkBlock dup586 == false                                       -- bad-txnmrklroot
def dup2_586 : Block := ⟨block586.header, [block586.vtx.getD 0 genesisCoinbase, block586.vtx.getD 1 genesisCoinbase, block586.vtx.getD 1 genesisCoinbase]⟩   -- [a,b,b]: the equal pair is at an odd position, not flagged
#eval blockMerkleRoot dup2_586 == (ofHex "def487b0f0b89cc1502de927c0c3e4c1b0156f0b69c1a3a93031e1506d00944e", false)
def empty586 : Block := ⟨block586.header, []⟩
#eval blockMerkleRoot empty586 == (zeroHash, false)                    -- ComputeMerkleRoot of no hashes is uint256()
#eval checkBlock empty586 == false
def twoCb586 : Block := ⟨block586.header, [block586.vtx.getD 0 genesisCoinbase, block586.vtx.getD 0 genesisCoinbase, block586.vtx.getD 2 genesisCoinbase]⟩
#eval checkBlock twoCb586 == false                                     -- bad-cb-multiple (the root also differs)
